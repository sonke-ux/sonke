        // Function to call Gemini API
        async function callGeminiAPI(promptText) {
            const systemPrompt = "Act as an expert eThekwini Municipal Rates Advisor. Provide concise, helpful, and professional answers regarding property valuations, municipal billing, rates disputes, and payment arrangements.";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=`;
            
            const payload = {
                contents: [{ parts: [{ text: promptText }] }],
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                }
            };

            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                const candidate = result.candidates?.[0];
                if (candidate && candidate.content?.parts?.[0]?.text) {
                    return candidate.content.parts[0].text;
                }
                return "I am unable to retrieve an AI response at the moment. Please contact the eThekwini Municipality helpline.";
            } catch (err) {
                console.error("Gemini API Error:", err);
                return "Error connecting to Gemini AI. Please try again later.";
            }
        }

