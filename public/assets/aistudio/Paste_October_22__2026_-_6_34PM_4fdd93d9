<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>eThekwini Municipal Rates Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Add jsPDF for PDF generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: '#0ea5e9', // Sky 500
                        primaryHover: '#0284c7', // Sky 600
                        secondary: '#0f172a', // Slate 900
                        background: '#f8fafc', // Slate 50
                        surface: '#ffffff',
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: theme('colors.background'); }
        .fade-in { animation: fadeIn 0.4s ease-in-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .loader {
            border: 3px solid #f3f3f3;
            border-radius: 50%;
            border-top: 3px solid theme('colors.primary');
            width: 24px;
            height: 24px;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        @keyframes bounceFace {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-10px) scale(1.05); }
        }
        .animate-face { animation: bounceFace 1.5s ease-in-out infinite; }
    </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col font-sans">

    <!-- Greeting Overlay -->
    <div id="greetingOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-md z-50 flex flex-col items-center justify-center transition-opacity duration-500">
        <div class="bg-white p-8 rounded-3xl shadow-2xl flex flex-col items-center max-w-sm mx-4 text-center border border-slate-100">
            <div class="w-20 h-20 bg-sky-500 rounded-full flex items-center justify-center text-white shadow-lg mb-4 animate-face">
                <i class="fa-solid fa-face-smile text-4xl"></i>
            </div>
            <h3 class="text-xl font-extrabold text-slate-900 mb-1" id="greetingTitle">Welcome to MuniRates</h3>
            <p class="text-slate-500 text-sm mb-6" id="greetingSubtitle">Loading eThekwini Municipal Portal with Gemini AI...</p>
            <div class="loader"></div>
        </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="bg-white shadow-sm border-b border-slate-200 sticky top-0 z-10">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-3 flex-1">
                    <button onclick="goHome()" class="flex items-center gap-3 hover:opacity-80 transition-opacity text-left cursor-pointer">
                        <div class="bg-primary text-white p-2 rounded-lg">
                            <i class="fa-solid fa-building-columns text-xl"></i>
                        </div>
                        <span class="font-bold text-xl text-secondary tracking-tight">Muni<span class="text-primary">Rates</span></span>
                    </button>
                </div>
                
                <!-- Center AI Search & Auth Status -->
                <div class="hidden md:flex flex-col flex-1 justify-center items-center w-full px-4">
                    <div class="relative w-full max-w-md group">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                            <i class="fa-solid fa-wand-magic-sparkles text-primary group-focus-within:animate-pulse"></i>
                        </div>
                        <input type="text" id="globalAiSearch" onkeydown="handleGlobalSearch(event)" placeholder="Ask Gemini AI: How do I dispute my valuation?" class="block w-full pl-10 pr-4 py-2 border border-slate-200 rounded-full text-sm bg-slate-50 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all shadow-inner">
                    </div>
                    
                    <!-- Pre-login auth block -->
                    <div class="flex items-center gap-3 mt-1.5" id="adminAuthBlock">
                        <button onclick="openAdminModal()" class="text-[10px] uppercase tracking-wider font-bold text-slate-400 hover:text-primary transition-colors flex items-center gap-1 cursor-pointer">
                            <i class="fa-solid fa-lock"></i> Staff / Admin Access
                        </button>
                        <span class="text-[10px] uppercase tracking-wider font-bold text-emerald-500 flex items-center gap-1 bg-emerald-50 px-2 py-0.5 rounded-full" title="Gemini AI Security Agent Active: Bot protection and traffic encryption enabled.">
                            <i class="fa-solid fa-shield-halved"></i> AI Secured
                        </span>
                    </div>

                    <!-- Post-login user info block -->
                    <div class="hidden items-center gap-2 mt-1.5 bg-slate-100 px-3 py-1 rounded-full border border-slate-200 shadow-inner" id="adminLoggedInBlock">
                        <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                            <i class="fa-solid fa-circle-user text-slate-400 text-sm"></i> 
                            Logged in as: <span id="loggedInAdminName" class="capitalize text-primary"></span>
                        </span>
                        <div class="w-px h-3 bg-slate-300 mx-1"></div>
                        <span id="loggedInAdminRole" class="text-[10px] uppercase tracking-wider font-bold text-white px-2 py-0.5 rounded-full shadow-sm"></span>
                    </div>
                </div>

                <!-- Right Side Actions -->
                <div class="flex items-center gap-4 flex-1 justify-end">
                    <button id="inboxNavBtn" onclick="openInboxModal()" class="text-slate-500 hover:text-primary transition-colors relative hidden cursor-pointer" title="Municipal Inbox">
                        <i class="fa-regular fa-envelope text-xl"></i>
                        <span id="inboxBadge" class="absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] font-bold rounded-full h-4 w-4 flex items-center justify-center">2</span>
                    </button>
                    <button onclick="openResidentAuthModal()" id="userProfileBtn" class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 transition-colors px-3 py-1.5 rounded-full text-slate-600 font-semibold cursor-pointer border border-slate-200 shadow-sm">
                        <i class="fa-solid fa-user text-sm"></i>
                        <span id="userNameDisplay" class="text-sm">Resident Login</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow flex flex-col items-center pt-10 pb-16 px-4 sm:px-6 lg:px-8 w-full max-w-6xl mx-auto">
        
        <!-- Header Text -->
        <div class="text-center mb-10 w-full" id="headerSection">
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3 tracking-tight">Check Municipal Rates</h1>
            <p class="text-slate-500 max-w-2xl mx-auto text-base md:text-lg">Easily view your property details, outstanding balances, and recent municipal billing history. Powered by Gemini AI for instant assistance.</p>
        </div>

        <!-- Search Card -->
        <div class="w-full max-w-2xl bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 mb-8" id="searchSection">
            <form id="searchForm" class="flex flex-col gap-4">
                <div class="flex flex-col gap-2">
                    <label for="searchQuery" class="text-sm font-semibold text-slate-700">Search by Account Number or SA ID Number</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
                        </div>
                        <input type="text" id="searchQuery" name="searchQuery" required placeholder="e.g. 123456789 or 9001015000000" 
                            class="block w-full pl-10 pr-3 py-3 border border-slate-300 rounded-xl leading-5 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary sm:text-sm transition-shadow">
                    </div>
                    <p class="text-xs text-slate-500 mt-1"><i class="fa-solid fa-shield-halved mr-1"></i> Gemini AI secure encrypted connection.</p>
                </div>
                <button type="submit" class="w-full flex justify-center items-center gap-2 py-3 px-4 border border-transparent rounded-xl shadow-sm text-sm font-semibold text-white bg-primary hover:bg-primaryHover focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors cursor-pointer">
                    <span>Find Account</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>
        </div>

        <!-- Loading State -->
        <div id="loadingState" class="hidden flex-col items-center justify-center py-12 w-full">
            <div class="loader mb-4"></div>
            <p class="text-slate-500 font-medium">Retrieving account records via Gemini AI...</p>
        </div>

        <!-- Resident Dashboard -->
        <div id="dashboardSection" class="hidden w-full flex-col gap-6 fade-in">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <div>
                    <h2 class="text-xl font-bold text-slate-900" id="dashName">Account Owner: John Doe</h2>
                    <p class="text-slate-500 text-sm mt-1">Account No: <span id="dashAccNo" class="font-medium text-slate-700"></span></p>
                </div>
                <button onclick="resetSearch()" class="text-sm font-medium text-slate-500 hover:text-slate-800 flex items-center gap-1 transition-colors border border-slate-200 px-3 py-1.5 rounded-lg hover:bg-slate-50 cursor-pointer">
                    <i class="fa-solid fa-rotate-left"></i> New Search
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Outstanding Balance -->
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-rose-50 rounded-bl-full -mr-4 -mt-4 z-0"></div>
                    <div class="relative z-10">
                        <div class="flex justify-between items-center mb-2">
                            <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Total Amount Due</h3>
                            <i class="fa-solid fa-wallet text-rose-500"></i>
                        </div>
                        <div class="text-3xl font-extrabold text-slate-900 mb-1" id="dashBalance">R 0.00</div>
                        <p class="text-sm font-medium text-rose-600 bg-rose-50 inline-block px-2 py-0.5 rounded text-xs mt-1">Due by <span id="dashDueDate"></span></p>
                    </div>
                    <div class="mt-5 relative z-10">
                        <button onclick="openPaymentModal()" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2.5 px-4 rounded-xl transition-colors shadow-sm flex justify-center items-center gap-2 cursor-pointer">
                            Pay Now <i class="fa-regular fa-credit-card"></i>
                        </button>
                    </div>
                </div>

                <!-- Last Payment -->
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-center">
                    <div class="flex justify-between items-center mb-2">
                        <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Last Payment Received</h3>
                        <i class="fa-solid fa-circle-check text-emerald-500"></i>
                    </div>
                    <div class="text-2xl font-bold text-slate-900 mb-1" id="dashLastPayment">R 0.00</div>
                    <p class="text-sm text-slate-500 mt-1">Processed on <span id="dashLastPaymentDate" class="font-medium"></span></p>
                    <div class="mt-4 pt-4 border-t border-slate-100">
                        <button onclick="generateReceiptPDF()" class="text-sm text-primary hover:text-primaryHover font-medium flex items-center gap-1 cursor-pointer">Download Receipt <i class="fa-solid fa-download text-xs"></i></button>
                    </div>
                </div>

                <!-- Property Details -->
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-center">
                     <div class="flex justify-between items-center mb-4">
                        <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Property Information</h3>
                        <i class="fa-solid fa-house-chimney text-primary"></i>
                    </div>
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs text-slate-400 font-medium">Physical Address</p>
                            <p class="text-sm font-semibold text-slate-800 leading-tight" id="dashAddress"></p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-400 font-medium">Municipal Valuation</p>
                            <div class="flex justify-between items-center">
                                <p class="text-sm font-semibold text-slate-800" id="dashValuation"></p>
                                <button onclick="askAIAssistant('valuation')" class="text-xs text-primary hover:text-primaryHover font-medium flex items-center gap-1 bg-sky-50 px-2 py-1 rounded transition-colors cursor-pointer" title="Ask Gemini AI about this valuation">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i> Explain
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Outstanding Monthly Payments Table -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-6">
                <div class="px-6 py-5 border-b border-slate-200 flex justify-between items-center bg-slate-50">
                    <h3 class="text-lg font-bold text-slate-800"><i class="fa-solid fa-clock-rotate-left text-rose-500 mr-2"></i>Outstanding Monthly Payments</h3>
                    <button onclick="askAIAssistant('billing')" class="text-sm text-primary hover:text-primaryHover font-medium bg-sky-50 border border-sky-100 transition-colors px-3 py-1.5 rounded-lg shadow-sm flex items-center gap-1 cursor-pointer">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> Gemini AI Analysis
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-white text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
                                <th class="px-6 py-4 font-semibold">Month</th>
                                <th class="px-6 py-4 font-semibold">Description</th>
                                <th class="px-6 py-4 font-semibold text-right">Amount (ZAR)</th>
                                <th class="px-6 py-4 font-semibold text-center">Status</th>
                                <th class="px-6 py-4 font-semibold text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="outstandingBillingTableBody" class="text-sm divide-y divide-slate-100"></tbody>
                    </table>
                </div>
            </div>

            <!-- Cleared Monthly Payments Table -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-200 flex justify-between items-center bg-slate-50">
                    <h3 class="text-lg font-bold text-slate-800"><i class="fa-solid fa-circle-check text-emerald-500 mr-2"></i>Cleared Monthly Payments</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-white text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
                                <th class="px-6 py-4 font-semibold">Month</th>
                                <th class="px-6 py-4 font-semibold">Description</th>
                                <th class="px-6 py-4 font-semibold text-right">Amount (ZAR)</th>
                                <th class="px-6 py-4 font-semibold text-center">Status</th>
                                <th class="px-6 py-4 font-semibold text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="clearedBillingTableBody" class="text-sm divide-y divide-slate-100"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Admin & Staff Dashboard -->
        <div id="adminDashboardSection" class="hidden w-full flex-col gap-6 fade-in">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900" id="adminDashboardTitle"><i class="fa-solid fa-shield-halved text-primary mr-2"></i>Admin Dashboard</h2>
                    <p class="text-slate-500 text-sm mt-1">Overview of Accounts, Monthly Payments Tracking & Gemini AI Arrears Agent</p>
                </div>
                <button onclick="logoutAdmin()" class="text-sm font-medium text-rose-500 hover:text-rose-700 flex items-center gap-2 transition-colors border border-rose-200 px-4 py-2 rounded-lg hover:bg-rose-50 shadow-sm cursor-pointer">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i> Secure Logout
                </button>
            </div>

            <!-- Admin Search Bar Section -->
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3">
                <div class="bg-primary/10 p-3 rounded-xl text-primary flex items-center justify-center">
                    <i class="fa-solid fa-magnifying-glass text-lg"></i>
                </div>
                <div class="flex-1 relative">
                    <input type="text" id="adminAccountSearchInput" oninput="filterAdminTable()" placeholder="Search accounts by name or account number..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white transition-all">
                </div>
                <div class="hidden sm:flex items-center gap-2 px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-500">
                    <i class="fa-solid fa-filter text-primary"></i> Live Database Search
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-center border-l-4 border-l-rose-500">
                    <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2">Total Arrears</h3>
                    <div class="text-2xl font-extrabold text-slate-900" id="adminTotalDebt">R 0.00</div>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-center border-l-4 border-l-emerald-500">
                    <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2">Payments Made vs Due</h3>
                    <div class="text-2xl font-extrabold text-slate-900" id="adminPaymentsRatio">0 / 0</div>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-center border-l-4 border-l-amber-500">
                    <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2">Accounts in Arrears</h3>
                    <div class="text-2xl font-extrabold text-slate-900" id="adminTotalAccounts">0</div>
                </div>
                <div class="bg-slate-900 rounded-2xl p-6 shadow-sm flex flex-col justify-center relative overflow-hidden group">
                    <div class="absolute right-0 top-0 w-24 h-24 bg-emerald-500/10 rounded-bl-full z-0 group-hover:bg-emerald-500/20 transition-colors"></div>
                    <div class="relative z-10 flex flex-col h-full justify-between">
                        <div>
                            <h3 class="text-sm font-semibold text-emerald-400 uppercase tracking-wider mb-1"><i class="fa-solid fa-robot mr-1"></i> Gemini AI Tracker</h3>
                            <p class="text-xs text-slate-400">Monthly tracking & notices</p>
                        </div>
                        <button onclick="runAiScanModal()" class="mt-4 w-full bg-emerald-500 hover:bg-emerald-600 text-white text-sm font-bold py-2 rounded-xl transition-colors shadow-sm cursor-pointer">
                            Run Monthly Scan & Send Notices
                        </button>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-200 flex justify-between items-center bg-slate-50">
                    <h3 class="text-lg font-bold text-slate-800">Ratepayer Accounts & Monthly Status</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-white text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
                                <th class="px-6 py-4 font-semibold">Account No.</th>
                                <th class="px-6 py-4 font-semibold">Ratepayer Name</th>
                                <th class="px-6 py-4 font-semibold text-right">Outstanding (ZAR)</th>
                                <th class="px-6 py-4 font-semibold text-center">Status</th>
                                <th class="px-6 py-4 font-semibold text-center">Action / Clearance</th>
                            </tr>
                        </thead>
                        <tbody id="adminTableBody" class="text-sm divide-y divide-slate-100"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- Edit Account Modal -->
    <div id="editAccountModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg mx-4 transform scale-95 transition-transform duration-300" id="editAccountModalContent">
            <div class="flex justify-between items-center p-6 border-b border-slate-100">
                <h3 class="text-lg font-bold text-slate-800"><i class="fa-solid fa-pen-to-square text-primary mr-2"></i>Edit Resident Account Details</h3>
                <button onclick="closeEditAccountModal()" class="text-slate-400 hover:text-slate-600 transition-colors cursor-pointer">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            <div class="p-6 max-h-[70vh] overflow-y-auto">
                <form id="editAccountForm" onsubmit="event.preventDefault(); saveAccountEdits();" class="flex flex-col gap-4">
                    <input type="hidden" id="editAccNo">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Ratepayer Name</label>
                        <input type="text" id="editAccName" required class="w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary focus:outline-none text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-2">Monthly Rates & Status</label>
                        <div id="editMonthlyRatesContainer" class="space-y-3 bg-slate-50 p-4 rounded-xl border border-slate-200"></div>
                    </div>
                    <button type="submit" class="w-full mt-2 bg-primary hover:bg-primaryHover text-white font-bold py-3 px-4 rounded-xl transition-colors shadow-sm cursor-pointer">
                        Save Account Changes
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-8 mt-auto">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:text-left flex flex-col sm:flex-row justify-between items-center gap-4">
            <p class="text-slate-500 text-sm">© 2026 Municipal Rates Portal. All rights reserved.</p>
            <div class="flex gap-4 text-slate-400">
                <a href="#" class="hover:text-primary transition-colors"><i class="fa-brands fa-facebook text-xl"></i></a>
                <a href="#" class="hover:text-primary transition-colors"><i class="fa-brands fa-twitter text-xl"></i></a>
                <a href="#" class="hover:text-primary transition-colors"><i class="fa-solid fa-envelope text-xl"></i></a>
            </div>
        </div>
    </footer>

    <!-- Payment Modal -->
    <div id="paymentModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 transform scale-95 transition-transform duration-300" id="paymentModalContent">
            <div class="flex justify-between items-center p-6 border-b border-slate-100">
                <h3 class="text-lg font-bold text-slate-800">Secure Payment</h3>
