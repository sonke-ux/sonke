        function populateAdminTable(searchQuery = '') {
            const formatCurrency = (num) => 'R ' + num.toLocaleString('en-ZA', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            let totalDebt = 0;
            let totalMonthsDue = 0;
            let totalMonthsPaid = 0;
            const tbody = document.getElementById('adminTableBody');
            tbody.innerHTML = '';
            let arrearCount = 0;

            const query = searchQuery.toLowerCase().trim();
            const filteredAccounts = adminAccounts.filter(item => 
                item.name.toLowerCase().includes(query) || item.acc.toLowerCase().includes(query)
            );

            filteredAccounts.forEach(item => {
                totalDebt += item.balance;
                if (item.balance > 0) arrearCount++;

                item.monthlyRates.forEach(mr => {
                    totalMonthsDue++;
                    if (mr.paid) totalMonthsPaid++;
                });
                
                let statusBadgeClass = 'bg-amber-100 text-amber-700';
                if (item.balance === 0 || item.status === 'Paid Up') {
                    statusBadgeClass = 'bg-emerald-100 text-emerald-700 font-bold';
                }

                let actionsHtml = `<button onclick="openEditAccountModal('${item.acc}')" class="text-xs bg-sky-100 hover:bg-sky-200 text-sky-800 py-1 px-2.5 rounded shadow-sm font-semibold cursor-pointer"><i class="fa-solid fa-pen"></i> Edit</button>`;
                
                if (currentAdmin === 'sonke' && item.balance > 0) {
                    actionsHtml += ` <button onclick="clearResidentAccount('${item.acc}')" class="text-xs bg-emerald-100 hover:bg-emerald-200 text-emerald-800 py-1 px-2.5 rounded shadow-sm font-semibold cursor-pointer"><i class="fa-solid fa-check"></i> Clear Account</button>`;
                }

                item.monthlyRates.forEach((mr, idx) => {
                    if (mr.paid) {
                        actionsHtml += ` <button onclick="openPaidUpModal('${item.acc}', ${idx})" class="text-xs bg-emerald-100 hover:bg-emerald-200 text-emerald-800 py-1.5 px-2.5 rounded shadow-sm font-semibold cursor-pointer"><i class="fa-solid fa-file-signature"></i> ${mr.month}</button>`;
                    }
                });

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition-colors";
                tr.innerHTML = `
                    <td class="px-6 py-4 whitespace-nowrap text-slate-600 font-medium">${item.acc}</td>
                    <td class="px-6 py-4 text-slate-800 font-semibold">${item.name}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right font-bold ${item.balance > 0 ? 'text-rose-600' : 'text-emerald-600'}">${formatCurrency(item.balance)}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-center">
                        <span class="${statusBadgeClass} py-1 px-2.5 rounded-full text-xs font-semibold">${item.status}</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-center flex items-center justify-center gap-1.5 flex-wrap">
                        ${actionsHtml}
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('adminTotalDebt').textContent = formatCurrency(totalDebt);
            document.getElementById('adminPaymentsRatio').textContent = `${totalMonthsPaid} / ${totalMonthsDue}`;
            document.getElementById('adminTotalAccounts').textContent = arrearCount;
        }

