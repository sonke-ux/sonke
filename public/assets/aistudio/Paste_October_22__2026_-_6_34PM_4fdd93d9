                    mr.amount = amt;
                    mr.paid = paid;
                    if (!paid) totalBal += amt;
                });
                acc.balance = totalBal;
                acc.status = totalBal === 0 ? "Paid Up" : "Arrears";
            }
            closeEditAccountModal();
            populateAdminTable();
        }

        function runAiScanModal() {
            const modal = document.getElementById('aiScanModal');
            const content = document.getElementById('aiScanModalContent');
            const loader = document.getElementById('aiScanLoader');
            const results = document.getElementById('aiScanResults');

            loader.classList.remove('hidden');
            results.classList.add('hidden');
            loader.classList.add('flex');

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                content.classList.remove('scale-95');
                content.classList.add('scale-100');
            }, 10);

            setTimeout(() => {
                loader.classList.add('hidden');
                loader.classList.remove('flex');
                results.classList.remove('hidden');
                results.classList.add('flex');
            }, 2000);
        }

        function closeAiScanModal() {
            const modal = document.getElementById('aiScanModal');
            const content = document.getElementById('aiScanModalContent');
            modal.classList.add('opacity-0');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); }, 300);
        }

        function openPaidUpModal(accNo, monthIndex) {
            const modal = document.getElementById('paidUpModal');
            const content = document.getElementById('paidUpModalContent');
            
            document.getElementById('paidUpAccNo').value = accNo;
            document.getElementById('paidUpMonthIndex').value = monthIndex;
            
            const account = adminAccounts.find(a => a.acc === accNo);
            const monthData = account ? account.monthlyRates[monthIndex] : { month: "Selected Month", amount: 0 };

            document.getElementById('paidUpModalSubtitle').textContent = `Generating clearance for ${monthData.month}.`;
            document.getElementById('paidUpMessage').value = `This official document certifies that the municipal rates account for ${account ? account.name : 'the ratepayer'} (Account Number: ${accNo}) for the billing month of ${monthData.month} is fully paid up.\n\nThank you for your prompt payments to eThekwini Municipality.`;

            const stampBox = document.getElementById('stampControlBox');
            const staffBox = document.getElementById('staffWarningBox');
            const checkbox = document.getElementById('applyStampCheckbox');

            if (currentAdmin === 'sonke') {
                stampBox.classList.remove('hidden');
                staffBox.classList.add('hidden');
                checkbox.checked = false;
            } else {
                stampBox.classList.add('hidden');
                staffBox.classList.remove('hidden');
                checkbox.checked = false;
            }

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                content.classList.remove('scale-95');
                content.classList.add('scale-100');
            }, 10);
        }

        function closePaidUpModal() {
            const modal = document.getElementById('paidUpModal');
            const content = document.getElementById('paidUpModalContent');
            modal.classList.add('opacity-0');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); }, 300);
        }

        function downloadPaidUpPDF() {
            const accNo = document.getElementById('paidUpAccNo').value;
            const monthIndex = parseInt(document.getElementById('paidUpMonthIndex').value);
            const message = document.getElementById('paidUpMessage').value;
            const applyStamp = currentAdmin === 'sonke' && document.getElementById('applyStampCheckbox').checked;

            const account = adminAccounts.find(a => a.acc === accNo) || { name: "Unknown", monthlyRates: [] };
            const monthData = account.monthlyRates[monthIndex] || { month: "Billing Month", amount: 0 };

            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();

            doc.setFontSize(24);
            doc.setFont("helvetica", "bold");
            doc.text("eThekwini Municipality", 105, 25, { align: "center" });
            
            doc.setFontSize(14);
            doc.setFont("helvetica", "normal");
            doc.text(`Monthly Clearance Certificate (${monthData.month})`, 105, 35, { align: "center" });
            doc.line(20, 45, 190, 45); 

            doc.setFontSize(12);
            doc.setFont("helvetica", "bold");
            doc.text("Account & Billing Details", 20, 55);
            doc.setFont("helvetica", "normal");
            doc.text(`Account Holder: ${account.name}`, 20, 65);
            doc.text(`Account Number: ${accNo}`, 20, 75);
            doc.text(`Billing Month: ${monthData.month}`, 20, 85);
            doc.text(`Amount Cleared: R ${monthData.amount.toFixed(2)}`, 20, 95);
            doc.line(20, 105, 190, 105);

            doc.setFontSize(11);
            const splitText = doc.splitTextToSize(message, 170);
            doc.text(splitText, 20, 120);

            if (applyStamp && currentAdmin === 'sonke') {
                doc.setDrawColor(220, 38, 38); 
                doc.setLineWidth(1.5);
                doc.circle(150, 175, 25); 
                doc.setLineWidth(0.5);
                doc.circle(150, 175, 23);

                doc.setTextColor(220, 38, 38);
                doc.setFontSize(10);
                doc.setFont("helvetica", "bold");
                doc.text("OFFICIALLY", 150, 167, { align: "center" });
                doc.text("VERIFIED", 150, 177, { align: "center" });
                doc.text("Sonke (Admin)", 150, 187, { align: "center" });
                
                doc.setTextColor(0, 0, 120);
                doc.setFont("times", "italic");
                doc.setFontSize(16);
                doc.text("Sonke", 150, 215, { align: "center" });
                
                doc.setFont("helvetica", "normal");
                doc.setFontSize(10);
                doc.setTextColor(0, 0, 0);
                doc.text("System Administrator Approval", 150, 223, { align: "center" });
            } else {
                 doc.setTextColor(200, 200, 200);
                 doc.setFontSize(40);
                 doc.text("DRAFT COPY", 105, 170, { angle: 45, align: "center" });
            }

            doc.save(`Monthly_Clearance_${accNo}_${monthData.month.replace(/\s+/g, '_')}.pdf`);
            closePaidUpModal();
        }

        function toggleChat() {
            const win = document.getElementById('aiChatWindow');
            if (win.classList.contains('hidden')) {
                win.classList.remove('hidden');
                win.classList.remove('scale-0', 'opacity-0');
                win.classList.add('scale-100', 'opacity-100');
            } else {
                win.classList.remove('scale-100', 'opacity-100');
                win.classList.add('scale-0', 'opacity-0');
                setTimeout(() => { win.classList.add('hidden'); }, 300);
            }
        }

        async function askAIAssistant(topic) {
            toggleChat();
            let prompt = "";
            if (topic === 'valuation') {
                prompt = "Can you explain how my municipal property valuation was calculated in eThekwini and how I can dispute it if necessary?";
            } else if (topic === 'billing') {
                prompt = "Could you analyze my recent municipal billing history and summarize my account status?";
            }
            if (prompt) {
                await sendPromptToChat(prompt);
            }
        }
    </script>
